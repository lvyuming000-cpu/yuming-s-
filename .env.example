# ============================================================
# 风味设计工作台 · 环境变量
# 复制成 .env 再填。除了 ANTHROPIC_API_KEY,其余都有默认值。
# ============================================================

# ---- 推演引擎(必填,否则卡片能开但不能推演)----
ANTHROPIC_API_KEY=sk-ant-...
# 也可以用 `ant auth login` 的 profile,不设这个变量即可

# 模型与推理强度。默认 claude-opus-5 / high。
# 成本敏感时可降到 medium;长程复杂推演可上 xhigh。
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=16000

# 每轮送进模型的历史消息条数上限
HISTORY_TURNS=16

# ---- 语音转写(可选)----
# 不配的话只有浏览器原生语音可用(Chrome/Edge/Safari 较新版本)。
# 规格 §6.3 建议生产环境接专业转写服务 —— 中文风味术语准确率差别明显。
# 走 OpenAI 兼容的 /audio/transcriptions 协议:
#   Whisper API、自建 faster-whisper、多数国内厂商的兼容层都吃这个形状。
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=sk-...
# STT_MODEL=whisper-1
# STT_LANGUAGE=zh
# 风味术语提示,显著改善专有名词转写。留空用内置的那份。
# STT_PROMPT=

# ---- 服务端 ----
PORT=8787
# 数据存放目录(单文件 JSON)
DATA_DIR=./data
